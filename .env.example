POSTGRES_PASSWORD=change-me
# Used when the app runs on your machine; docker compose points the api container at db:5432 itself.
DATABASE_URL=postgresql+psycopg://kowshick:change-me@localhost:5433/app_db
JWT_SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
SEED_OFFICER_PASSWORD=change-me
# text (default, readable, coloured status) or json (one JSON object per line)
LOG_FORMAT=text
